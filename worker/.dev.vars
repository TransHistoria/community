# Worker local development secrets — copy to .dev.vars (gitignored) and fill in.
# Do NOT commit real secrets to this file or to .dev.vars.

# Auth / app basics
JWT_SECRET=dev-secret-change-me
ADMIN_EMAILS=admin@example.test
FRONTEND_URL=http://localhost:3000
EMAIL_FROM=跨性别空间 <noreply@example.test>
APP_NAME=跨性别空间
APP_LOCALE=zh-CN

# Optional: bootstrap secret for the initial admin
CREATE_ADMIN=dev-secret

# Optional: Cloudflare Turnstile for sign-up captcha
# TURNSTILE_SECRET_KEY=

# Optional: enable verbose error responses
# DEBUG=1

# ---- LLM content moderation (Anthropic-compatible endpoint) ----
# Used by worker/src/lib/llm.ts for posts/comments/events content review.
# Leave LLM_API_KEY empty to disable LLM and fall back to keyword-only filtering.
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
