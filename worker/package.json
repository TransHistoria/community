{
  "name": "transcommunity-worker",
  "version": "0.1.0",
  "private": true,
  "description": "TransCommunity Cloudflare Worker backend",
  "scripts": {
    "dev": "wrangler dev",
    "setup": "wrangler d1 migrations apply transcommunity --remote",
    "deploy": "pnpm run setup && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply transcommunity --local",
    "db:migrate:remote": "wrangler d1 migrations apply transcommunity --remote",
    "db:create": "wrangler d1 create transcommunity"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.6",
    "mimetext": "^3.0.24",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.101.0"
  }
}
