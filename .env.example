# -----------------------------------------------------------------------
# Frontend environment variables
# Copy this file to .env.local for local development.
# In CI / GitHub Actions set these as repository variables (not secrets).
# -----------------------------------------------------------------------

# Full base URL of the Cloudflare Worker backend, no trailing slash.
# If left empty or unset the frontend falls back to the default dev worker:
#   https://transcommunity.cyanmint.workers.dev
NEXT_PUBLIC_API_URL=https://transcommunity.cyanmint.workers.dev

# Optional secondary API base URL used when the primary host is blocked
# by extensions/network policies (for example workers.dev blocked by client).
NEXT_PUBLIC_API_FALLBACK_URL=https://community.transhistoria.org

# Optional: base path when the site is served from a GitHub Pages sub-path.
# For a repo named "community" under org "TransHistoria" this would be
# "/community".  Leave blank if serving from a custom domain root.
NEXT_PUBLIC_BASE_PATH=
