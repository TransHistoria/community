# --- Database ---
# Local dev: postgres running on localhost
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trans_community?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-with-a-long-random-string"
# In dev, this is auto-detected; in prod set to your origin
AUTH_URL="http://localhost:3000"

# --- Email (Resend) ---
# Leave RESEND_API_KEY empty in dev to log emails to console instead of sending
RESEND_API_KEY=""
EMAIL_FROM="Trans Community <noreply@example.com>"
# Optional Mailpit/Mailhog SMTP for local
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# --- Storage ---
# "local" stores under ./storage/uploads, served via /api/files/[...]
# "s3"    uses S3-compatible storage (works with R2, B2, MinIO, COS, OSS)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""

# --- App ---
# Comma-separated emails: any user signing in with these is auto-promoted to ADMIN
ADMIN_EMAILS=""
# Comma-separated; empty = all categories enabled
ENABLED_CATEGORIES=""
# Default app locale
APP_LOCALE="zh-CN"
APP_NAME="跨性别社群"
