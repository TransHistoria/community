{
  "name": "trans-community",
  "version": "0.1.0",
  "private": true,
  "description": "私域跨性别社群活动发布与报名平台",
  "scripts": {
    "dev": "next dev",
    "frontend": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "dev:worker": "wrangler dev",
